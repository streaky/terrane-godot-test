namespace nbody

from /core/output import print
from /nbody/godot import advance-godot-view, godot-body-color, godot-draw-position, new-godot-view, render-godot-frame, simulation-time-scale

function main;
    view = new-godot-view;
    view = advance-godot-view; move view, 0.25
    frame = render-godot-frame; ref view
    _ = godot-draw-position; 0.0, 0.0
    _ = godot-body-color;
    scale = simulation-time-scale;
    print; 'Terrane CPU N-body smoke frame: ', frame.bodies.length, ' bodies at ', view.simulation.elapsed, ' seconds and ', scale, '× time'
