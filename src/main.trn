namespace nbody

from /core/output import print
from /nbody/godot import advance-godot-view, godot-body-color, godot-draw-position, new-godot-view, render-godot-frame, simulation-time-scale

function main;
    view = new-godot-view;
    view = advance-godot-view; move view, 0.25
    frame = render-godot-frame; ref view
    first = frame.bodies[0]
    _ = godot-draw-position; 0.0, 0.0
    _ = godot-body-color; ref first
    scale = simulation-time-scale;
    print; 'Terrane CPU N-body smoke frame: ', frame.bodies.length, ' bodies, ', view.completed-steps, ' steps, first body at (', first.x, ', ', first.y, ') with radius ', first.radius, ' after ', view.simulation.elapsed, ' seconds and ', scale, '× time'
